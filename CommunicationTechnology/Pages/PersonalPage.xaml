<Page x:Class="CommunicationTechnology.Pages.PersonalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunicationTechnology.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PersonalPage">
    <!--Страница личного кабинета-->
    <Grid>
        <!--UniformGrid контейнер, размещающий свои элементы в сетку с одинаковым
        размером ячеек
        свойства Columns указывает на количество в этой сетке колонок, Rows - строк-->
        <UniformGrid Columns="2">
            <!--Click добавляет исполнение какого-либо события при клике на кнопку
            действия события прописываются в cs файле страницы-->
            <Button x:Name="CostButton" Click="CostButton_Click">Расходы</Button>
            <Button x:Name="TariffButton" Click="TariffButton_Click">Настройка тарифа</Button>
            <Button x:Name="ServicesButton" Click="ServicesButton_Click">Услуги</Button>
            <Button x:Name="SupportButton" Click="SupportButton_Click">Поддержка</Button>
        </UniformGrid>
    </Grid>
</Page>
