<Application x:Class="CommunicationTechnology.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CommunicationTechnology"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--Добавление цветов, используемых в приложении-->
        <SolidColorBrush x:Key="ColorMain" Color="#FF0032"/>
        <SolidColorBrush x:Key="ColorAdditional" Color="#000000"/>

        <!--Прописывание стилей для отдельных элементов
        Target указывает для каких элементов применяется стиль-->
        
        <!--Стили для подписей-->
        <Style x:Key="TitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource ColorMain}"/>
        </Style>

        <Style x:Key="PriceLabel" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource ColorAdditional}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource ColorMain}"/>
        </Style>

        <!--Стили для кнопок-->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="30"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="{StaticResource ColorMain}"/>
        </Style>
        
        <Style x:Key="NavigateNutton" TargetType="Button">
            <Setter Property="Margin" Value="5,10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="{StaticResource ColorMain}"/>
        </Style>

        <!--Стили для ползунков-->
        <Style TargetType="Slider">
            <Setter Property="Width" Value="150"/>
        </Style>

        <!--Стили для выпадающих списков-->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ColorMain}"/>
        </Style>
    </Application.Resources>
</Application>
