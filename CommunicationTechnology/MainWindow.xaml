<Window x:Class="CommunicationTechnology.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunicationTechnology"
        mc:Ignorable="d"
        Height="450" Width="800"
        Title="Технологии связи" SizeToContent="WidthAndHeight" 
        MaxWidth="800" MinWidth="400"
        MaxHeight="600" MinHeight="400">
    <Grid>
        <!--Title задает заголовок окна
        SizeToContent позволяет подбирать свой размер под размер всех элементов в форме
        MaxWidth задает макс. ширину экрана
        MinWidth задает мин. ширину экрана
        MaxHeight задает макс. высоту экрана
        MinHeight задает мин. высоту экрана-->

        <!--Созданное окно, в котором мы сейчас нахадимся - MainWindow.xaml 
        контейнер для всех страниц приложения-->

        <!--Контейнер будет содержать заголовок(логотип, заголовок окна, кнопка назад)
        и основной блок - фрейм с именем MainFrame - он нужен для реализации навигации
        приложения (будут отображаться нужные страницы)-->

        <!--Определение строк в grid - контейнер, выступающий в качестве таблицы,
        в котором можно определить строки/колонки их количество и размеры-->
        <Grid.RowDefinitions>
            <!--Первая строка с высотой 60-->
            <RowDefinition Height="60"/>
            <!--Вторая строка, которая будет занимать все остальное пространство(*)-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Пошло само наполнение грида-->

        <!--Image - тег картинки, свойство source указывает на источник, откуда
        приложение берет картинку (в нашем случае logo.png из папки Img),
        HorizontalAlignment определяет выравнивание этого элемента относительно
        родительского блока-->
        <Image Source="/Img/logo.png" HorizontalAlignment="Left"/>

        <!--Label - тег подписи,
        HorizontalAlignment уже знаком, а вот VerticalAlignment делает то же самое,
        но горизонтально-->
        <Label HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Style="{StaticResource TitleLabel}">
            Технологии связи
        </Label>

        <!--Button - тег кнопки,
        x:Name - свойство присвоения имени элементу, чтобы к нему можно было обратиться
        в cs файле
        Visibility отвечает за отображение элемента на странице-->
        <Button x:Name="BackButton" HorizontalAlignment="Right" 
                Click="BackButton_Click"
                Style="{StaticResource NavigateNutton}">
            ←
        </Button>

        <!--Frame, как упоминалось ранее, нужен для удобной навигации по приложению,
        Grid.Row используется для обозначения положения элемента в родительском grid
        по порядку
        NavigationUIVisibility свойство отображения интерфейса юзера, для
        гармоничности с дизайном, его следует спрятать (Hidden)
        -->
        <!--Событие ContentRendered сигнализирует, что содержимое элемента 
        отображено на экране и готово к взаимодействию с юзером-->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
               ContentRendered="MainFrame_ContentRendered">
            
        </Frame>
    </Grid>
</Window>
